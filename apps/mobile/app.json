{
    "expo": {
        "name": "A2APoint",
        "slug": "a2apoint-community",
        "version": "1.0.0-dev.6",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "a2apoint-community",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "com.a2apoint.community",
            "buildNumber": "1.22"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#FAF9F8"
            },
            "package": "com.a2apoint.community",
            "versionCode": 22
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/icon2.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#FAF9F8",
                    "dark": {
                        "image": "./assets/images/icon2.png",
                        "resizeMode": "contain",
                        "backgroundColor": "#0E0D0D"
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}