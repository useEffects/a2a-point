{
  "expo": {
    "name": "A2APoint",
    "slug": "a2apoint-community",
    "version": "2.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "a2apoint-community",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.a2apoint.community",
      "buildNumber": "2.10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "associatedDomains": ["applinks:a2apoint.com"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF9F8"
      },
      "package": "com.a2apoint.community",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "a2apoint.com",
              "pathPrefix": "/listings"
            },
            {
              "scheme": "https",
              "host": "a2apoint.com",
              "pathPrefix": "/agents"
            },
            {
              "scheme": "https",
              "host": "a2apoint.com",
              "pathPrefix": "/locations"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "versionCode": 10
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon2.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F8",
          "dark": {
            "image": "./assets/images/icon2.png",
            "resizeMode": "contain",
            "backgroundColor": "#0E0D0D"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "a2apoint",
          "project": "a2apoint",
          "url": "https://glitchtip.a2apoint.com"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b24eff2c-8bf8-44cc-ab5a-355b44d36cc9"
      }
    }
  }
}
