WEBSOCKETS_ENABLED=true
WEBSOCKETS_REST_AUTH="strict"
LOG_LEVEL="info"
CACHE_ENABLED=true
SESSION_COOKIE_NAME="directus_session_token"
SESSION_COOKIE_DOMAIN="a2apoint.com"
CORS_ENABLED=true
CORS_ORIGIN="https://a2apoint.com/api/auth-redirect,https://dev.a2apoint.com/api/auth-redirect"
EXTENSIONS_AUTO_RELOAD=true
EMAIL_FROM="info@a2apoint.com"
AUTH_PROVIDERS="keycloak"
AUTH_KEYCLOAK_DRIVER="openid"
AUTH_KEYCLOAK_MODE="session"
AUTH_KEYCLOAK_IDENTIFIER_KEY="email"
AUTH_KEYCLOAK_ALLOW_PUBLIC_REGISTRATION=true
AUTH_KEYCLOAK_REDIRECT_ALLOW_LIST="https://a2apoint.com/api/auth-redirect,https://dev.a2apoint.com/api/auth-redirect"