{
	"name": "theme",
	"description": "Please enter a description for your extension",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "theme",
				"name": "A2APoint dark theme",
				"source": "src/dark.ts"
			},
			{
				"type": "theme",
				"name": "A2APoint light theme",
				"source": "src/light.ts"
			}
		],
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "11.0.6"
	},
	"dependencies": {
		"color": "^4.2.3",
		"hex-color-opacity": "^0.4.2",
		"tailwind-theme": "*"
	}
}
